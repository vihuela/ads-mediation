<!-- Host-owned assets, shared by AdMob and TopOn. Inspired by short-drama's native card. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingHorizontal="22dp" android:paddingVertical="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <ImageView android:id="@+id/native_icon" android:layout_width="52dp" android:layout_height="52dp"
            android:layout_marginEnd="12dp" android:scaleType="centerCrop" android:contentDescription="Ad icon" />
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/native_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#333333" android:textSize="16sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end" />
            <TextView android:id="@+id/native_body" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:textColor="#777777" android:textSize="12sp" android:maxLines="2" android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center_vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ad"
            android:textSize="11sp" android:textColor="#FFFFFF" android:background="#666666" android:paddingHorizontal="5dp" />
        <TextView android:id="@+id/native_advertiser" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:textSize="11sp" android:textColor="#777777" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <TextView android:id="@+id/native_cta" android:layout_width="match_parent" android:layout_height="48dp"
        android:layout_marginTop="16dp" android:background="@drawable/demo_native_cta" android:gravity="center"
        android:textColor="#060606" android:textStyle="bold" android:textSize="15sp" />
</LinearLayout>
